{% set raw = layer.metadata.get('raw_ini_text') if layer.metadata is not none else None %}
{% if raw is not none and raw.get('lines') is not none %}
{%- for entry in raw.lines -%}
{{ entry.text }}{% if not loop.last or raw.endswith_newline %}
{% endif %}
{%- endfor -%}
{% else %}
[General]
{% set general_list = layer.nodes | selectattr('id','equalto','General') | list %}
{% if general_list %}
{% for key, value in general_list[0].attrs.items() %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}
{% endif %}
