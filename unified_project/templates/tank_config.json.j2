{% set raw = layer.metadata.get('raw_text') if layer.metadata is not none else None %}
{% if raw is not none and raw.get('lines') is not none %}
{%- for entry in raw.lines -%}
{{ entry.text }}{% if not loop.last or raw.endswith_newline %}
{% endif %}
{%- endfor -%}
{% else %}
{% set file_paths_node = (layer.nodes | selectattr('id','equalto','file_paths') | list) %}
{% set simulator_node = (layer.nodes | selectattr('id','equalto','simulator') | list) %}
{% set influx_node = (layer.nodes | selectattr('id','equalto','influxdb') | list) %}
{% set states = layer.nodes | selectattr('type','equalto','state') | list %}
{
  "file_paths": {{ (file_paths_node[0].attrs if file_paths_node|length > 0 else {}) | tojson(indent=2) }},
  "simulator": {{ (simulator_node[0].attrs if simulator_node|length > 0 else {}) | tojson(indent=2) }},
  "state": [
{% for n in states %}
    {{ n.attrs | tojson(indent=4) }}{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "influxdb": {{ (influx_node[0].attrs if influx_node|length > 0 else {}) | tojson(indent=2) }}
}
{% endif %}
