# ====== Core ======
DEBUG=1
SECRET_KEY=changeme-in-prod

# ====== Broker/Cache ======
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=actions

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Connection URIs derived by settings.py if not provided
# RABBITMQ_URL=amqp://admin:password@rabbitmq:5672//
# REDIS_URL=redis://redis:6379/0

# ====== InfluxDB (optional, mock if not reachable) ======
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=demo-org
INFLUX_BUCKET=demo-bucket

# ====== KEDA tuning (used by templates) ======
KEDA_MIN_REPLICAS=0
KEDA_MAX_REPLICAS=10
KEDA_COOLDOWN=30
KEDA_POLLING=5
